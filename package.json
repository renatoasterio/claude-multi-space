{
  "name": "claude-multispace",
  "productName": "Claude MultiSpace",
  "version": "0.1.0",
  "description": "Abra várias instâncias do Claude Desktop e do Claude Code CLI, cada uma com uma conta diferente.",
  "main": "out/main/main.js",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "author": {
    "name": "Renato Asterio",
    "url": "https://github.com/renatoasterio"
  },
  "homepage": "https://github.com/renatoasterio/claude-multispace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renatoasterio/claude-multispace.git"
  },
  "bugs": {
    "url": "https://github.com/renatoasterio/claude-multispace/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "multi-account",
    "electron",
    "profiles"
  ]
}
